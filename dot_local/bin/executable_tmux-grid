#!/usr/bin/env bash
# tmux-grid - lay out the current tmux session as N windows with an equal pane grid
#
#   tmux-grid <n>   ensure the session has $WINDOWS windows and set every window to
#                   n panes (1, 2, 3, 4 or 6), then apply the grid layout.
#                   Windows with too few panes are split; windows with too many open
#                   a picker so you can choose which panes to close.
#                   In a session that is still one window with one pane, it first
#                   asks which directory the whole grid should start in.
#   tmux-grid       re-apply the grid layout to each window based on the pane
#                   count it already has (use after manually killing panes)
#
# Grids are rows x columns: 2 -> 1x2, 3 -> 1x3, 4 -> 2x2, 6 -> 2x3.
# Only panes sitting idle at a shell prompt can be closed - a pane running a command,
# or whose shell has a background job, is shown but locked.
#
# Window 1 is the claude area: its idle panes are started with $TMUX_GRID_W1_CMD,
# which defaults to claude. Set it empty for a grid of plain shells.

set -u

WINDOWS=5

usage() {
    cat >&2 <<'USAGE'
usage: tmux-grid [1|2|3|4|6]

  1  1x1    2  1x2    3  1x3    4  2x2    6  2x3   (rows x columns)

  with an argument: create windows up to 5, then grow each window to that many panes,
    or - when a window has too many - open a picker to choose which idle panes to close
  without an argument: just re-apply the layout for each window's current pane count

  in a fresh session (one window, one pane) you are asked which directory to start in,
    listing $TMUX_GRID_ROOT (default ~/workspace)
  window 1's idle panes are then started with $TMUX_GRID_W1_CMD (default claude);
    set it empty for plain shells
USAGE
    exit 1
}

# rows and columns for a pane count, empty when there is no exact grid for it
grid_dims() {
    case "$1" in
        2) echo "1 2" ;;
        3) echo "1 3" ;;
        4) echo "2 2" ;;
        6) echo "2 3" ;;
        *) echo "" ;;
    esac
}

grid_name() {
    local dims
    dims="$(grid_dims "$1")"
    if [ -n "$dims" ]; then
        echo "${dims% *}x${dims#* }"
    else
        echo "$1 panes"
    fi
}

# Build a tmux layout string for an exact rows x cols grid.
# tmux's own "tiled" is not usable here: for 6 panes it produces 3x2, and for 3
# panes a ragged 2x2. A layout string gives the exact geometry instead; tmux
# assigns the window's panes to the cells in order, so contents are preserved.
layout_string() {
    local width="$1" height="$2" rows="$3" cols="$4"
    awk -v W="$width" -v H="$height" -v rows="$rows" -v cols="$cols" '
    function sizes(total, k, out,   avail, base, rem, i) {
        avail = total - (k - 1)
        base = int(avail / k)
        rem = avail - base * k
        for (i = 1; i <= k; i++)
            out[i] = base + (i > k - rem ? 1 : 0)
    }
    function checksum(s,   c, i, n) {
        c = 0
        n = length(s)
        for (i = 1; i <= n; i++) {
            c = int(c / 2) + (c % 2) * 32768
            c = (c + ord[substr(s, i, 1)]) % 65536
        }
        return sprintf("%04x", c)
    }
    BEGIN {
        for (i = 0; i < 256; i++) ord[sprintf("%c", i)] = i
        sizes(H, rows, rh)
        sizes(W, cols, cw)

        body = sprintf("%dx%d,0,0", W, H)
        id = 0
        y = 0

        if (rows == 1) {
            body = body "{"
            x = 0
            for (c = 1; c <= cols; c++) {
                body = body sprintf("%s%dx%d,%d,0,%d", (c > 1 ? "," : ""), cw[c], H, x, ++id)
                x += cw[c] + 1
            }
            body = body "}"
        } else if (cols == 1) {
            body = body "["
            for (r = 1; r <= rows; r++) {
                body = body sprintf("%s%dx%d,0,%d,%d", (r > 1 ? "," : ""), W, rh[r], y, ++id)
                y += rh[r] + 1
            }
            body = body "]"
        } else {
            body = body "["
            for (r = 1; r <= rows; r++) {
                body = body sprintf("%s%dx%d,0,%d{", (r > 1 ? "," : ""), W, rh[r], y)
                x = 0
                for (c = 1; c <= cols; c++) {
                    body = body sprintf("%s%dx%d,%d,%d,%d", (c > 1 ? "," : ""), cw[c], rh[r], x, y, ++id)
                    x += cw[c] + 1
                }
                body = body "}"
                y += rh[r] + 1
            }
            body = body "]"
        }

        print checksum(body) "," body
    }'
}

apply_layout() {
    local window="$1" count="$2" dims rows cols size layout

    [ "$count" -lt 2 ] && return 0

    dims="$(grid_dims "$count")"
    if [ -n "$dims" ]; then
        rows="${dims% *}"
        cols="${dims#* }"
        size="$(tmux display-message -p -t "$window" '#{window_width} #{window_height}')"
        layout="$(layout_string "${size% *}" "${size#* }" "$rows" "$cols")"
        tmux select-layout -t "$window" "$layout" >/dev/null 2>&1 && return 0
    fi

    # no exact grid for this count (or the window is too small for one)
    if [ "$count" -le 3 ]; then
        tmux select-layout -t "$window" even-horizontal >/dev/null
    else
        tmux select-layout -t "$window" tiled >/dev/null
    fi
}

pane_count() {
    tmux list-panes -t "$1" -F '#{pane_id}' | wc -l | tr -d ' '
}

# Largest pane (by area) in a window - splitting that one avoids "no space for new pane"
largest_pane() {
    tmux list-panes -t "$1" -F '#{pane_width} #{pane_height} #{pane_id}' \
        | awk '{ a = $1 * $2; if (a > m) { m = a; id = $3 } } END { print id }'
}

# --- closing panes -----------------------------------------------------------

is_shell() { # cmd
    case "$1" in
        zsh | bash | sh | fish | ksh | dash | tcsh | csh) return 0 ;;
    esac
    return 1
}

# Echoes a reason when the pane must not be closed, nothing when it is idle.
pane_busy_reason() { # cmd pid
    is_shell "$1" || {
        echo "busy: $1"
        return
    }
    pgrep -P "$2" >/dev/null 2>&1 && echo "busy: bg job"
}

# Last non-blank line above the prompt row: the last command run, or its output.
# #{cursor_y} is the prompt's row, so capturing above it skips the live prompt.
pane_hint() { # pane_id
    local cy
    cy="$(tmux display-message -p -t "$1" '#{cursor_y}' 2>/dev/null)"
    [ -n "$cy" ] && [ "$cy" -gt 0 ] || return 0
    tmux capture-pane -p -t "$1" -S 0 -E "$((cy - 1))" 2>/dev/null \
        | grep -v '^[[:space:]]*$' | tail -1 \
        | tr '\t' ' ' | tr -d '\000-\037' \
        | sed '/^%$/d'   # zsh's marker for output with no trailing newline
}

short_path() {
    echo "${1/#$HOME/~}"
}

# Progress goes to stdout when a terminal is reading it. Launched from the key
# binding there is none: run-shell collects stdout and drops the pane into a view
# you have to press q to leave, so use the status line instead. Lines are gathered
# and shown as one message, since a second display-message would erase the first.
NOTES=""
note() {
    if [ -t 1 ]; then
        echo "$1"
    else
        NOTES="${NOTES:+$NOTES - }$1"
    fi
}

flush_notes() {
    [ -n "$NOTES" ] && tmux display-message "$NOTES"
    NOTES=""
}

# sets TRUNC - a function rather than $(...) so a redraw forks nothing
trunc() { # text width
    if [ "${#1}" -gt "$2" ]; then
        TRUNC="${1:0:$(($2 - 1))}…"
    else
        TRUNC="$1"
    fi
}

# --- the picker (internal --pick mode) ---------------------------------------
# Reads separator-delimited rows from a file and returns the pane ids to close.
# Globals rather than locals: this runs as its own short lived process.

pick_setup() {
    STTY_SAVE="$(stty -g </dev/tty)"
    stty -echo -icanon min 1 time 0 </dev/tty
    printf '\033[?1049h\033[?25l' >/dev/tty
}

pick_restore() {
    printf '\033[?25h\033[?1049l' >/dev/tty
    [ -n "${STTY_SAVE:-}" ] && stty "$STTY_SAVE" </dev/tty
    STTY_SAVE=""
}

# Emits up/down/enter/esc/bs/quit, or c:<char> for any other key - the callers
# decide what a letter means, because the directory picker types them into a filter.
# bash 3.2 has no fractional read timeout, so tell the tty driver to return
# after 0.1s instead: that is how a lone ESC is told from an arrow key.
read_key() {
    local k rest
    if ! IFS= read -rsn1 k </dev/tty; then
        printf quit
        return
    fi
    if [ "$k" = $'\033' ]; then
        # bash's own read -n forces VMIN=1 and would block here, swallowing the
        # next keypress; dd does a plain read() that honours min 0 / time 1, so a
        # lone ESC comes back empty while an arrow still has its "[A" waiting.
        stty min 0 time 1 </dev/tty
        rest="$(dd bs=1 count=2 2>/dev/null </dev/tty)"
        stty min 1 time 0 </dev/tty
        case "$rest" in
            '[A') printf up ;;
            '[B') printf down ;;
            '') printf esc ;;
            *) printf other ;;
        esac
        return
    fi
    case "$k" in
        '') printf enter ;;
        $'\177' | $'\010') printf bs ;;
        *) printf 'c:%s' "$k" ;;
    esac
}

pick_row() { # index - sets ROW
    local i="$1" mark box label line cmd path tail
    label="${R_WI[$i]}.${R_PIDX[$i]}"

    trunc "${R_CMD[$i]}" 8
    cmd="$TRUNC"
    trunc "${R_PATH[$i]}" "$PATHW"
    path="$TRUNC"
    trunc "${R_BUSY[$i]:-${R_HINT[$i]}}" "$HINTW"
    tail="$TRUNC"

    if [ -n "${R_BUSY[$i]}" ]; then
        mark="   "
        box="    "
    else
        if [ "${NAV[$CUR]}" = "$i" ]; then mark=" > "; else mark="   "; fi
        if [ "${R_SEL[$i]}" = 1 ]; then box="[x] "; else box="[ ] "; fi
    fi

    printf -v line '%s%s%-6s %-8s %-*s  %s' \
        "$mark" "$box" "$label" "$cmd" "$PATHW" "$path" "$tail"

    if [ -n "${R_BUSY[$i]}" ]; then
        ROW=$'\033[2m'"$line"$'\033[0m'
    elif [ "${NAV[$CUR]}" = "$i" ]; then
        ROW=$'\033[1m'"$line"$'\033[0m'
    else
        ROW="$line"
    fi
}

pick_render() {
    local i k wi seen pass need out avail

    # lay the whole list out first, then show the slice the cursor is in
    NL=0
    for ((k = 0; k < NWINS; k++)); do
        wi="${WINS[$k]}"
        seen=0
        for ((i = 0; i < N; i++)); do
            [ "${R_WI[$i]}" = "$wi" ] && [ "${R_SEL[$i]}" = 1 ] && seen=$((seen + 1))
        done
        need=$((${WIN_RM[$k]} - seen))
        if [ "$need" -le 0 ]; then
            LINES[$NL]="  window $wi  ✓"
        else
            LINES[$NL]="  window $wi  - remove $need"
        fi
        NL=$((NL + 1))
        for pass in 0 1; do
            for ((i = 0; i < N; i++)); do
                [ "${R_WI[$i]}" = "$wi" ] || continue
                if [ "$pass" = 0 ]; then
                    [ -z "${R_BUSY[$i]}" ] || continue
                else
                    [ -n "${R_BUSY[$i]}" ] || continue
                fi
                pick_row "$i"
                LINES[$NL]="$ROW"
                [ -z "${R_BUSY[$i]}" ] && [ "${NAV[$CUR]}" = "$i" ] && CURLINE=$NL
                NL=$((NL + 1))
            done
        done
        LINES[$NL]=""
        NL=$((NL + 1))
    done

    avail=$((ROWS - 3))
    [ "$avail" -lt 3 ] && avail=3
    if [ "$NL" -le "$avail" ]; then
        TOP=0
    else
        [ "$CURLINE" -lt "$TOP" ] && TOP="$CURLINE"
        [ "$CURLINE" -ge $((TOP + avail)) ] && TOP=$((CURLINE - avail + 1))
        [ $((TOP + avail)) -gt "$NL" ] && TOP=$((NL - avail))
        [ "$TOP" -lt 0 ] && TOP=0
    fi

    out=$'\033[H\033[2J'
    out="$out  select panes to close    space toggle · enter confirm · q cancel"$'\n\n'
    for ((i = TOP; i < NL && i < TOP + avail; i++)); do
        out="$out${LINES[$i]}"$'\n'
    done
    out="$out  $SELCOUNT of $TOTALRM selected"
    [ "$NL" -gt "$avail" ] && out="$out    (showing $((TOP + 1))-$((TOP + avail)) of $NL)"
    printf '%s' "$out" >/dev/tty
}

picker() { # infile outfile
    local in="$1" out="$2" i k found size key idx
    local wi rm pid pidx cmd path busy hint

    N=0
    NWINS=0
    TOTALRM=0
    SELCOUNT=0
    CUR=0
    CANCELLED=0
    WINS=""
    NAV=""

    while IFS=$'\037' read -r wi rm pid pidx cmd path busy hint; do
        [ -n "$pid" ] || continue
        R_WI[$N]="$wi"
        R_RM[$N]="$rm"
        R_PID[$N]="$pid"
        R_PIDX[$N]="$pidx"
        R_CMD[$N]="$cmd"
        R_PATH[$N]="$path"
        R_BUSY[$N]="$busy"
        R_HINT[$N]="$hint"
        R_SEL[$N]=0
        N=$((N + 1))
    done <"$in"
    [ "$N" -gt 0 ] || return 1

    # windows in first-seen order, with how many panes each needs to lose
    for ((i = 0; i < N; i++)); do
        found=0
        for ((k = 0; k < NWINS; k++)); do
            [ "${WINS[$k]}" = "${R_WI[$i]}" ] && found=1 && break
        done
        if [ "$found" = 0 ]; then
            WINS[$NWINS]="${R_WI[$i]}"
            WIN_RM[$NWINS]="${R_RM[$i]}"
            TOTALRM=$((TOTALRM + ${R_RM[$i]}))
            NWINS=$((NWINS + 1))
        fi
    done

    # navigable rows, in the order they are drawn (idle panes only)
    NNAV=0
    for ((k = 0; k < NWINS; k++)); do
        for ((i = 0; i < N; i++)); do
            [ "${R_WI[$i]}" = "${WINS[$k]}" ] || continue
            [ -z "${R_BUSY[$i]}" ] || continue
            NAV[$NNAV]=$i
            NNAV=$((NNAV + 1))
        done
    done
    [ "$NNAV" -gt 0 ] || return 1

    size="$(stty size </dev/tty 2>/dev/null)" || size="24 80"
    ROWS="${size% *}"
    COLS="${size#* }"
    TOP=0
    CURLINE=0
    PATHW=24
    HINTW=$((COLS - 34 - PATHW))
    [ "$HINTW" -lt 20 ] && HINTW=20

    trap 'pick_restore' EXIT INT TERM
    pick_setup

    while :; do
        pick_render
        key="$(read_key)"
        case "$key" in
            up | 'c:k') [ "$CUR" -gt 0 ] && CUR=$((CUR - 1)) ;;
            down | 'c:j') [ "$CUR" -lt $((NNAV - 1)) ] && CUR=$((CUR + 1)) ;;
            'c: ')
                idx="${NAV[$CUR]}"
                if [ "${R_SEL[$idx]}" = 1 ]; then
                    R_SEL[$idx]=0
                    SELCOUNT=$((SELCOUNT - 1))
                else
                    R_SEL[$idx]=1
                    SELCOUNT=$((SELCOUNT + 1))
                fi
                ;;
            enter) break ;;
            quit | esc | 'c:q')
                CANCELLED=1
                break
                ;;
        esac
    done

    pick_restore
    trap - EXIT INT TERM

    [ "$CANCELLED" = 1 ] && return 1

    : >"$out"
    for ((i = 0; i < N; i++)); do
        [ "${R_SEL[$i]}" = 1 ] && echo "${R_PID[$i]}" >>"$out"
    done
    return 0
}

# --- window 1 runs the sessions ----------------------------------------------

# Starts $W1_CMD in window 1. Only panes sitting at a shell prompt are touched:
# sending the text to a pane already running claude would submit it as a prompt
# rather than start anything, so a re-run must skip them.
launch_window1() {
    local w1 pid pidx cmd ppid ppath

    [ -n "$W1_CMD" ] || return 0
    w1="$(tmux list-windows -t "$SESSION" -F '#{window_id}' | head -1)"

    while read -r pid pidx cmd ppid ppath; do
        # the pane running this script looks busy because of the script itself;
        # its keys sit in the tty until we exit, after the cd queued above
        if [ "$pid" = "$CALLER" ]; then
            tmux send-keys -t "$pid" "$W1_CMD" Enter
            continue
        fi
        # only the foreground matters here: a pane created moments ago is still
        # spawning its rc-file children, which pane_busy_reason would call busy
        is_shell "$cmd" || continue
        tmux send-keys -t "$pid" "$W1_CMD" Enter
    done < <(tmux list-panes -t "$w1" \
        -F '#{pane_id} #{pane_index} #{pane_current_command} #{pane_pid} #{pane_current_path}')
}

# --- the directory picker (internal --pickdir mode) --------------------------
# Letters are typed into the filter here, so this one cancels on ESC, not q.

# rebuilds FIDX - the indices of the entries matching FILTER
dirpick_filter() {
    local i
    NF=0
    for ((i = 0; i < ND; i++)); do
        if [ -z "$FILTER" ]; then
            FIDX[$NF]=$i
            NF=$((NF + 1))
        else
            case "${D_LOW[$i]}" in
                *"$FILTER"*)
                    FIDX[$NF]=$i
                    NF=$((NF + 1))
                    ;;
            esac
        fi
    done
    [ "$DCUR" -ge "$NF" ] && DCUR=$((NF - 1))
    [ "$DCUR" -lt 0 ] && DCUR=0
}

dirpick_render() {
    local i out avail top
    avail=$((ROWS - 5))
    [ "$avail" -lt 3 ] && avail=3
    top=0
    [ "$DCUR" -ge "$avail" ] && top=$((DCUR - avail + 1))

    out=$'\033[H\033[2J'
    out="$out  select a directory    type to filter · enter confirm · esc cancel"$'\n'
    out="$out  filter: $FILTER"$'\n\n'
    if [ "$NF" = 0 ]; then
        out="$out  no match"$'\n'
    else
        for ((i = top; i < NF && i < top + avail; i++)); do
            if [ "$i" = "$DCUR" ]; then
                out="$out"$' > \033[1m'"${D_NAME[${FIDX[$i]}]}"$'\033[0m\n'
            else
                out="$out   ${D_NAME[${FIDX[$i]}]}"$'\n'
            fi
        done
    fi
    out="$out"$'\n'"  $NF of $ND"
    printf '%s' "$out" >/dev/tty
}

dirpicker() { # outfile
    local out="$1" d size key root

    root="${TMUX_GRID_ROOT:-$HOME/workspace}"
    [ -d "$root" ] || return 1

    ND=0
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        D_PATH[$ND]="$d"
        D_NAME[$ND]="${d##*/}"
        D_LOW[$ND]="$(printf '%s' "${d##*/}" | tr '[:upper:]' '[:lower:]')"
        ND=$((ND + 1))
    done < <(find "$root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
    [ "$ND" -gt 0 ] || return 1

    size="$(stty size </dev/tty 2>/dev/null)" || size="24 80"
    ROWS="${size% *}"
    FILTER=""
    DCUR=0
    DCANCEL=0
    dirpick_filter

    trap 'pick_restore' EXIT INT TERM
    pick_setup

    while :; do
        dirpick_render
        key="$(read_key)"
        case "$key" in
            up) [ "$DCUR" -gt 0 ] && DCUR=$((DCUR - 1)) ;;
            down) [ "$DCUR" -lt $((NF - 1)) ] && DCUR=$((DCUR + 1)) ;;
            enter) [ "$NF" -gt 0 ] && break ;;
            esc | quit)
                DCANCEL=1
                break
                ;;
            bs)
                FILTER="${FILTER%?}"
                dirpick_filter
                ;;
            c:*)
                FILTER="$FILTER$(printf '%s' "${key#c:}" | tr '[:upper:]' '[:lower:]')"
                dirpick_filter
                ;;
        esac
    done

    pick_restore
    trap - EXIT INT TERM

    [ "$DCANCEL" = 1 ] && return 1
    printf '%s\n' "${D_PATH[${FIDX[$DCUR]}]}" >"$out"
    return 0
}

# --- shrink pass -------------------------------------------------------------

# Runs one of the internal picker modes, preferring a popup over the grid so the
# layout is undisturbed.
run_popup() { # width height args...
    local w="$1" h="$2" zoomed clients cmd
    shift 2

    # Only pop up when a client is actually watching this session. With none,
    # tmux hands the popup to whatever other client is attached to the server -
    # it appears over someone else's session and blocks there.
    clients="$(tmux list-clients -t "$SESSION" -F '#{client_tty}' 2>/dev/null | wc -l | tr -d ' ')"

    if [ -z "${TMUX_GRID_NO_POPUP:-}" ] && [ "$clients" -gt 0 ]; then
        cmd="$(printf '%q ' "$SELF" "$@")"
        if tmux display-popup -E -w "$w" -h "$h" "$cmd" 2>/dev/null; then
            return 0
        fi
    fi

    # no client to host a popup: run inline, which needs a terminal to draw on
    if ! stty size 2>/dev/null >/dev/null </dev/tty; then
        echo "tmux-grid: no terminal for the picker - attach a client and retry" >&2
        return 1
    fi

    zoomed="$(tmux display-message -p -t "$CALLER" '#{window_zoomed_flag}')"
    [ "$zoomed" = 0 ] && tmux resize-pane -Z -t "$CALLER"
    "$SELF" "$@"
    [ "$zoomed" = 0 ] && tmux resize-pane -Z -t "$CALLER"
    return 0
}

# Offers the panes of every over-target window for closing, then closes the picks.
shrink_pass() {
    local infile outfile window have wi rm busy hint idle=0 over=0
    local pid pidx cmd ppid ppath

    infile="$(mktemp -t tmux-grid-in)" || return 0
    outfile="$(mktemp -t tmux-grid-out)" || return 0
    : >"$outfile"

    for window in $(tmux list-windows -t "$SESSION" -F '#{window_id}'); do
        have="$(pane_count "$window")"
        [ "$have" -gt "$TARGET" ] || continue
        over=1
        wi="$(tmux display-message -p -t "$window" '#{window_index}')"
        rm=$((have - TARGET))

        while read -r pid pidx cmd ppid ppath; do
            busy="$(pane_busy_reason "$cmd" "$ppid")"
            [ "$pid" = "$CALLER" ] && busy="busy: this pane"
            hint=""
            if [ -z "$busy" ]; then
                hint="$(pane_hint "$pid")"
                idle=$((idle + 1))
            fi
            printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' \
                "$wi" "$rm" "$pid" "$pidx" "$cmd" "$(short_path "$ppath")" "$busy" "$hint" \
                >>"$infile"
        done < <(tmux list-panes -t "$window" \
            -F '#{pane_id} #{pane_index} #{pane_current_command} #{pane_pid} #{pane_current_path}')
    done

    if [ "$over" = 1 ] && [ "$idle" = 0 ]; then
        echo "tmux-grid: every extra pane is busy - nothing can be closed" >&2
    elif [ "$over" = 1 ]; then
        run_popup 80% 85% --pick "$infile" "$outfile"
        while read -r pid; do
            [ -n "$pid" ] && tmux kill-pane -t "$pid" 2>/dev/null
        done <"$outfile"
    fi

    rm -f "$infile" "$outfile"
}

# --- main --------------------------------------------------------------------

# The popup re-runs this script by path, so $0 has to become an absolute one.
# Invoked as a bare name (from run-shell, or a keybinding) it has no directory at
# all, and resolving it against $PWD would point at nothing.
SELF="$0"
case "$SELF" in
    */*) ;;
    *) SELF="$(command -v "$0" 2>/dev/null || echo "$0")" ;;
esac
case "$SELF" in
    /*) ;;
    *) SELF="$(cd "$(dirname "$SELF")" && pwd)/$(basename "$SELF")" ;;
esac

if [ "${1:-}" = "--pick" ]; then
    picker "${2:-}" "${3:-}"
    exit $?
fi

if [ "${1:-}" = "--pickdir" ]; then
    dirpicker "${2:-}"
    exit $?
fi

[ -n "${TMUX:-}" ] || {
    echo "tmux-grid: not inside a tmux session" >&2
    exit 1
}

[ $# -le 1 ] || usage

TARGET="${1:-}"
case "$TARGET" in
    "" | 1 | 2 | 3 | 4 | 6) ;;
    *) usage ;;
esac

SESSION="$(tmux display-message -p '#{session_name}')"
CALLER="$(tmux display-message -p '#{pane_id}')"
START_DIR="$(tmux display-message -p '#{pane_current_path}')"
SPLIT_DIR=""
CHOSEN_DIR=""

# window 1 is the claude area; unset means claude, empty means leave it a plain grid
W1_CMD="${TMUX_GRID_W1_CMD-claude}"

# A session that is still one window with one pane has no working directory worth
# inheriting, so ask where this grid should live before building it.
if [ -n "$TARGET" ] \
    && [ "$(tmux list-windows -t "$SESSION" -F '#{window_id}' | wc -l | tr -d ' ')" = 1 ] \
    && [ "$(pane_count "$SESSION:")" = 1 ]; then
    dirfile="$(mktemp -t tmux-grid-dir)" && : >"$dirfile"
    run_popup 60% 50% --pickdir "$dirfile"
    CHOSEN_DIR="$(head -1 "$dirfile" 2>/dev/null)"
    rm -f "$dirfile"
    if [ -n "$CHOSEN_DIR" ]; then
        START_DIR="$CHOSEN_DIR"
        SPLIT_DIR="$CHOSEN_DIR"
        note "tmux-grid: starting in $CHOSEN_DIR"
    fi
fi

# new panes follow their source pane, unless a directory was just chosen
SPLIT_C='#{pane_current_path}'
[ -n "$SPLIT_DIR" ] && SPLIT_C="$SPLIT_DIR"

# Create missing windows (only when a target was given)
if [ -n "$TARGET" ]; then
    while [ "$(tmux list-windows -t "$SESSION" -F '#{window_id}' | wc -l | tr -d ' ')" -lt "$WINDOWS" ]; do
        tmux new-window -d -t "$SESSION:" -c "$START_DIR"
    done
    shrink_pass
fi

warned=0

for window in $(tmux list-windows -t "$SESSION" -F '#{window_id}'); do
    have="$(pane_count "$window")"

    if [ -n "$TARGET" ] && [ "$have" -gt "$TARGET" ]; then
        name="$(tmux display-message -p -t "$window" '#{session_name}:#{window_index}')"
        echo "tmux-grid: $name still has $have panes (more than $TARGET), laying it out as $have" >&2
        warned=1
    fi

    if [ -n "$TARGET" ]; then
        while [ "$have" -lt "$TARGET" ]; do
            pane="$(largest_pane "$window")"
            size="$(tmux display-message -p -t "$pane" '#{pane_width} #{pane_height}')"

            # split along the longer side; a cell is roughly twice as tall as wide
            if [ "${size% *}" -gt $(( ${size#* } * 2 )) ]; then
                direction="-h"
            else
                direction="-v"
            fi

            tmux split-window -d "$direction" -t "$pane" -c "$SPLIT_C" || {
                echo "tmux-grid: window too small to reach $TARGET panes" >&2
                exit 1
            }
            have=$((have + 1))
        done
    fi

    apply_layout "$window" "$have"
done

windows="$(tmux list-windows -t "$SESSION" -F '#{window_id}' | wc -l | tr -d ' ')"

if [ -n "$TARGET" ] && [ "$warned" = 1 ]; then
    note "tmux-grid: $windows windows, target of $TARGET panes not reached everywhere"
elif [ -n "$TARGET" ]; then
    note "tmux-grid: $windows windows x $TARGET panes ($(grid_name "$TARGET"))"
else
    note "tmux-grid: re-laid out $windows windows"
fi

flush_notes

# queued in the tty: the shell runs it as soon as this script exits
if [ -n "$CHOSEN_DIR" ]; then
    tmux send-keys -t "$CALLER" "cd $(printf %q "$CHOSEN_DIR")" Enter
fi

[ -n "$TARGET" ] && launch_window1

exit "$warned"
