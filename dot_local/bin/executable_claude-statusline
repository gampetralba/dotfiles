#!/usr/bin/env bash
# claude-statusline - one line for the Claude Code status line: which worktree,
# or which repo, this session is actually working in.
#
# Claude Code pipes the session as JSON on stdin. A top-level "worktree" object
# is present only while a worktree is active, which is the one reliable source:
# the claude process keeps its cwd at the project root either way, so nothing
# outside the session (a tmux pane border, say) can tell the worktrees apart.
#
# It also records the directory per tmux pane, which is what tmux-worktree-sync
# reads. Nothing else knows that mapping, and this command already runs - so no
# hook on every tool call is needed to keep it current.

set -u

STATE_DIR="/tmp/claude-worktree"

record() { # dir
    [ -n "${TMUX_PANE:-}" ] || return 0
    [ -n "$1" ] || return 0
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    printf '%s\n' "$1" >"$STATE_DIR/$TMUX_PANE" 2>/dev/null || return 0
}

json="$(cat)"

# one field per line: a blank line still reads as an empty field, which a
# separator-on-one-line split would get wrong
{
    read -r wt_name
    read -r wt_branch
    read -r wt_path
    read -r dir
} <<EOF
$(printf '%s' "$json" | jq -r '
    .worktree.name // "",
    .worktree.branch // "",
    .worktree.path // "",
    .workspace.current_dir // .cwd // ""
' 2>/dev/null)
EOF

if [ -n "${wt_name:-}" ]; then
    record "${wt_path:-${dir:-}}"
    printf '⑂ %s · %s' "$wt_name" "${wt_branch:-?}"
    exit 0
fi

[ -n "${dir:-}" ] || exit 0
record "$dir"

printf '%s' "${dir##*/}"
branch="$(git -C "$dir" branch --show-current 2>/dev/null)"
[ -n "$branch" ] && printf ' · %s' "$branch"

exit 0
